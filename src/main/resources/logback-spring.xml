<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <springProperty scope="context" name="APP_NAME" source="spring.application.name" defaultValue="rag-system"/>
    
    <!-- 控制台输出 - JSON格式 -->
    <appender name="CONSOLE_JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <customFields>{"application":"${APP_NAME}"}</customFields>
            <timestamp>yyyy-MM-dd'T'HH:mm:ss.SSS'Z'</timestamp>
        </encoder>
    </appender>
    
    <!-- 控制台输出 - 普通格式（开发调试用） -->
    <appender name="CONSOLE_TEXT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>
    
    <!-- 根据环境选择日志格式 -->
    <springProfile name="prod">
        <root level="INFO">
            <appender-ref ref="CONSOLE_JSON"/>
        </root>
    </springProfile>
    
    <springProfile name="!prod">
        <root level="INFO">
            <appender-ref ref="CONSOLE_TEXT"/>
        </root>
    </springProfile>
    
    <!-- 应用日志级别 -->
    <logger name="com.example.rag" level="INFO"/>
    <logger name="io.milvus" level="WARN"/>
    <logger name="com.volcengine" level="INFO"/>
</configuration>
